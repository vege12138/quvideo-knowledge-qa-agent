[
  {
    "doc_id": "D01",
    "title": "员工费用报销管理制度",
    "category": "人事财务",
    "version": "1.2",
    "version_date": "2026-01-10",
    "effective_date": "2026-02-01",
    "owner": "财务部",
    "scope": "全体正式员工（含试用期员工）",
    "status": "active",
    "chunks": [
      {
        "chunk_id": "D01-C01",
        "section": "适用对象",
        "text": "本制度适用于星映科技全体正式员工（含试用期员工）因公发生的交通、住宿、办公采购等合理费用。"
      },
      {
        "chunk_id": "D01-C02",
        "section": "报销提交时限",
        "text": "员工应在费用实际发生后的30个自然日内，通过内部报销系统提交报销申请。提交日期以系统记录为准。"
      },
      {
        "chunk_id": "D01-C03",
        "section": "提交材料",
        "text": "报销申请应附对应发票或合规收据、费用用途说明；差旅报销还应提供审批记录。"
      },
      {
        "chunk_id": "D01-C04",
        "section": "超期处理",
        "text": "超过规定提交期限的申请进入财务人工复核，不保证受理。"
      }
    ]
  },
  {
    "doc_id": "D02",
    "title": "费用报销操作补充通知",
    "category": "人事财务",
    "version": "1.0",
    "version_date": "2026-03-15",
    "effective_date": "2026-03-20",
    "owner": "财务运营组",
    "scope": "全体正式员工（含试用期员工）",
    "status": "active",
    "chunks": [
      {
        "chunk_id": "D02-C01",
        "section": "适用范围",
        "text": "本通知面向星映科技全体正式员工（含试用期员工），覆盖交通、住宿、办公采购等因公费用。"
      },
      {
        "chunk_id": "D02-C02",
        "section": "提交时限",
        "text": "员工应在费用实际发生后的15个自然日内，在内部报销系统完成报销提交。"
      },
      {
        "chunk_id": "D02-C03",
        "section": "材料完整性",
        "text": "提交时需上传发票或合规收据，并填写费用用途；差旅申请需关联对应的出差审批单。"
      },
      {
        "chunk_id": "D02-C04",
        "section": "流程说明",
        "text": "提交成功后由直属主管审核，再流转至财务部。此通知未载明与其他在行制度的废止关系或优先级规则。"
      }
    ]
  },
  {
    "doc_id": "D03",
    "title": "团队标准版产品与协作规则",
    "category": "产品文档",
    "version": "2.1",
    "version_date": "2026-04-02",
    "effective_date": "2026-04-10",
    "owner": "产品部",
    "scope": "订阅团队标准版的工作区",
    "status": "active",
    "chunks": [
      {
        "chunk_id": "D03-C01",
        "section": "适用套餐",
        "text": "本说明仅适用于当前订阅为团队标准版的工作区；不适用于团队专业版。"
      },
      {
        "chunk_id": "D03-C02",
        "section": "成员数量",
        "text": "团队标准版每个工作区最多允许5名活跃成员，包含工作区所有者。停用成员不计入活跃人数。"
      },
      {
        "chunk_id": "D03-C03",
        "section": "导出分辨率",
        "text": "团队标准版支持最高1080p的视频导出；可导出MP4文件。"
      },
      {
        "chunk_id": "D03-C04",
        "section": "人数上限提示",
        "text": "达到活跃成员上限时，须停用现有成员或升级套餐后才能继续邀请。"
      }
    ]
  },
  {
    "doc_id": "D04",
    "title": "团队专业版产品与协作规则",
    "category": "产品文档",
    "version": "3.0",
    "version_date": "2026-04-06",
    "effective_date": "2026-04-15",
    "owner": "产品部",
    "scope": "订阅团队专业版的工作区",
    "status": "active",
    "chunks": [
      {
        "chunk_id": "D04-C01",
        "section": "适用套餐",
        "text": "本说明仅适用于当前订阅为团队专业版的工作区；不适用于团队标准版。"
      },
      {
        "chunk_id": "D04-C02",
        "section": "成员数量",
        "text": "团队专业版每个工作区最多允许50名活跃成员，包含工作区所有者。上限按工作区计算，而不是按单个成员计算。"
      },
      {
        "chunk_id": "D04-C03",
        "section": "导出分辨率",
        "text": "团队专业版支持最高4K（3840×2160）的视频导出；支持MP4格式。"
      },
      {
        "chunk_id": "D04-C04",
        "section": "套餐切换",
        "text": "工作区升级为团队专业版后，成员上限按专业版规则执行；两个套餐的成员上限不可叠加。"
      }
    ]
  },
  {
    "doc_id": "D05",
    "title": "AI视频生成积分与扣费规则",
    "category": "产品规则",
    "version": "1.5",
    "version_date": "2026-05-08",
    "effective_date": "2026-05-12",
    "owner": "AI产品组",
    "scope": "团队标准版与团队专业版使用AI视频生成功能的工作区",
    "status": "active",
    "chunks": [
      {
        "chunk_id": "D05-C01",
        "section": "适用范围",
        "text": "本规则适用于团队标准版与团队专业版工作区中发起的AI视频生成任务。"
      },
      {
        "chunk_id": "D05-C02",
        "section": "积分消耗",
        "text": "发起一条AI视频生成任务时预扣20积分。任务成功完成后该20积分正式扣除。"
      },
      {
        "chunk_id": "D05-C03",
        "section": "任务失败返还",
        "text": "若平台将任务标记为生成失败，预扣的20积分应在失败发生后60分钟内自动返还至原工作区积分余额。"
      },
      {
        "chunk_id": "D05-C04",
        "section": "查询方法",
        "text": "管理员可以通过工作区设置中的“积分流水”查看预扣、扣除与返还记录。"
      }
    ]
  },
  {
    "doc_id": "D06",
    "title": "AI视频生成失败排障FAQ",
    "category": "技术支持",
    "version": "1.3",
    "version_date": "2026-06-02",
    "effective_date": "2026-06-05",
    "owner": "客户支持部",
    "scope": "团队标准版与团队专业版使用AI视频生成功能的工作区",
    "status": "active",
    "chunks": [
      {
        "chunk_id": "D06-C01",
        "section": "适用范围",
        "text": "本FAQ适用于团队标准版与团队专业版工作区使用AI视频生成时出现的失败任务。"
      },
      {
        "chunk_id": "D06-C02",
        "section": "故障排查",
        "text": "先检查工作区积分余额与任务状态；再刷新任务列表确认是否为暂时性网络问题；仍失败时记录任务ID并提交支持工单。"
      },
      {
        "chunk_id": "D06-C03",
        "section": "失败任务积分返还",
        "text": "生成失败任务的预扣积分必须在失败发生满24小时后才会返还，不能提前到账。"
      },
      {
        "chunk_id": "D06-C04",
        "section": "工单信息",
        "text": "提交故障工单时需提供工作区ID、失败任务ID、失败时间以及错误提示截图。"
      }
    ]
  },
  {
    "doc_id": "D07",
    "title": "企业API接入与权限申请指南",
    "category": "开发者支持",
    "version": "1.1",
    "version_date": "2026-06-18",
    "effective_date": "2026-06-25",
    "owner": "开放平台组",
    "scope": "已签约企业API服务的企业客户及其企业管理员",
    "status": "active",
    "chunks": [
      {
        "chunk_id": "D07-C01",
        "section": "服务范围",
        "text": "企业API仅对已签约企业API服务的客户开放，不因购买团队标准版或团队专业版而自动获得调用权限。"
      },
      {
        "chunk_id": "D07-C02",
        "section": "申请权限",
        "text": "只有企业管理员可以在开放平台控制台发起API开通申请。需填写企业名称、使用场景与技术联系人。"
      },
      {
        "chunk_id": "D07-C03",
        "section": "审批时间",
        "text": "申请资料齐全后，开放平台组通常在2个工作日内完成审核并通知申请结果。"
      },
      {
        "chunk_id": "D07-C04",
        "section": "密钥安全",
        "text": "API密钥仅在开通成功后由控制台展示；不得将密钥提交到公开代码仓库或向无关人员共享。"
      }
    ]
  },
  {
    "doc_id": "D08",
    "title": "员工请假与审批制度",
    "category": "人事行政",
    "version": "2.2",
    "version_date": "2026-07-01",
    "effective_date": "2026-07-10",
    "owner": "人力资源部",
    "scope": "全体正式员工（含试用期员工）",
    "status": "active",
    "chunks": [
      {
        "chunk_id": "D08-C01",
        "section": "年假申请",
        "text": "员工申请年假应至少提前2个工作日通过OA提交申请。"
      },
      {
        "chunk_id": "D08-C02",
        "section": "年假审批",
        "text": "连续请假不超过3个工作日的年假由直属主管审批；超过3个工作日的年假还需人力资源部复核。"
      },
      {
        "chunk_id": "D08-C03",
        "section": "病假申请",
        "text": "突发病假可先通知直属主管，并在返岗后1个工作日内补交OA请假申请及有效诊断证明。"
      },
      {
        "chunk_id": "D08-C04",
        "section": "未覆盖事项",
        "text": "本文件仅规定年假与病假的申请流程，不规定婚假、产假或陪产假的天数。"
      }
    ]
  }
]
